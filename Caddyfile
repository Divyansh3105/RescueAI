# SITE_ADDRESS is the deployed domain (not decided yet - PLAN.md Phase 1).
# Caddy gets a TLS certificate automatically for a real domain; "localhost"
# gets a local one. HTTPS is mandatory: geolocation and PWA install need it.
{$SITE_ADDRESS:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# SPA fallback: every other path serves the built index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
